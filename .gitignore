# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local embedded Postgres data (see scripts/local-db.mjs) — never committed,
# regenerated by initdb on first run
/.local-pg/

# typescript
*.tsbuildinfo
next-env.d.ts

# pdf.js decoders/fonts for the worksheet viewer — copied from node_modules
# by scripts/copy-pdfjs-assets.mjs before dev and build
/public/pdfjs/
